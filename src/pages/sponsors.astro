---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import Section from "../components/Section.astro";
import ExhibitorLogoCard from "../components/ExhibitorLogoCard.astro";
import sponsorsData from "../data/sponsors.json";
import { eventConfig } from "../lib/event-config";

const { page, host, groups, exhibitors } = sponsorsData;
const contactEmail = page.contactEmail || eventConfig.contactEmail;
const sponsorGroups = groups.map((group) => ({
  ...group,
  exhibitors: exhibitors
    .filter((exhibitor) => exhibitor.featured !== false && exhibitor.tier === group.id)
    .sort((a, b) => a.name.localeCompare(b.name, "en", { sensitivity: "base" })),
}));
---

<BaseLayout
  title="Exhibitors & Sponsors"
  description={`Sponsors and exhibitors for ${eventConfig.eventNameLong}, hosted by ${eventConfig.host}.`}
  canonicalPath="/sponsors"
>
  <PageHero eyebrow={page.eyebrow} title={page.title} intro={page.intro} host={host} />
  <Section>
    {
      sponsorGroups.map((group) => (
        <div class="sponsor-group">
          <h2 class="section-heading">{group.heading}</h2>
          <div class="exhibitor-grid">
            {group.exhibitors.map((exhibitor) => (
              <ExhibitorLogoCard
                name={exhibitor.name}
                logo={exhibitor.logo || undefined}
                logoAlt={exhibitor.logoAlt}
                url={exhibitor.url}
              />
            ))}
          </div>
        </div>
      ))
    }
    {page.moreComingNote && <p class="more-coming">{page.moreComingNote}</p>}
  </Section>

  <Section variant="soft">
    <h2 class="section-heading">{page.tiersHeading}</h2>
    <p class="tiers-intro">{page.tiersIntro}</p>
    <div class="sponsor-cta">
      {
        contactEmail ? (
          <Button href={`mailto:${contactEmail}?subject=${encodeURIComponent(`${eventConfig.eventName} 2027 sponsorship inquiry`)}`}>
            Email {contactEmail}
          </Button>
        ) : (
          <Button href="/contact">Contact the team</Button>
        )
      }
    </div>
  </Section>
</BaseLayout>

<style>
  .section-heading {
    margin: 0 0 18px;
    color: var(--color-navy);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    line-height: 1.15;
  }

  .sponsor-group + .sponsor-group {
    margin-top: 36px;
  }

  .exhibitor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 16px;
  }

  .more-coming {
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    text-align: center;
  }

  .tiers-intro {
    margin: 0 0 18px;
    color: var(--color-muted);
  }

  .sponsor-cta {
    margin-top: 22px;
  }

  @media (max-width: 820px) {
    .exhibitor-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
