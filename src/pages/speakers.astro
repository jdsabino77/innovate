---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import SpeakerCard from "../components/SpeakerCard.astro";
import speakersData from "../data/speakers.json";
import { eventConfig } from "../lib/event-config";

const { page, speakers } = speakersData;
const featuredSpeakers = speakers
  .filter((speaker) => speaker.featured !== false)
  .sort((a, b) => a.order - b.order);
const founders = featuredSpeakers.filter((speaker) => speaker.group === "founder");
const faculty = featuredSpeakers.filter((speaker) => speaker.group !== "founder");
---

<BaseLayout
  title="Speakers"
  description={`Faculty for ${eventConfig.eventName} — Dr. Arjang Yazdani, Nadine Sabino, RN, Ario Khoshbin, and Kimsy Kay, RPN. More speakers to be announced.`}
  canonicalPath="/speakers"
>
  <PageHero eyebrow={page.eyebrow} title={page.title} intro={page.intro} />
  <Section>
    <div class="speaker-groups">
      {
        founders.length > 0 && (
          <div class="speaker-grid speaker-grid-founders">
            {founders.map((speaker) => (
              <SpeakerCard {...speaker} />
            ))}
          </div>
        )
      }
      {
        faculty.length > 0 && (
          <div class="speaker-grid speaker-grid-faculty">
            {faculty.map((speaker) => (
              <SpeakerCard {...speaker} />
            ))}
          </div>
        )
      }
    </div>
    {page.moreComingNote && <p class="more-coming">{page.moreComingNote}</p>}
  </Section>
</BaseLayout>

<style>
  .speaker-groups {
    display: grid;
    gap: 28px;
  }

  .speaker-grid {
    display: grid;
    gap: 18px;
    align-items: stretch;
  }

  .speaker-grid-founders {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .speaker-grid-faculty {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .more-coming {
    margin: 28px 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    text-align: center;
  }

  @media (max-width: 820px) {
    .speaker-grid-founders,
    .speaker-grid-faculty {
      grid-template-columns: 1fr;
    }
  }
</style>
