---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import CtaBand from "../components/CtaBand.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import VenueCollage from "../components/VenueCollage.astro";
import home from "../data/home.json";
import tickets from "../data/tickets.json";
import schedule from "../data/schedule.json";
import { isLandingMode } from "../lib/launch";
import { eventConfig, siteDescription } from "../lib/event-config";
import { venue, getFeaturedPhotos, getVenuePhoto } from "../lib/venue";

const registerUrl = eventConfig.ticketing.checkoutUrl;
const pricingNote = tickets.pricing.summary;
const aboutImage = home.about.image
  ? { src: home.about.image, alt: home.about.imageAlt }
  : getVenuePhoto(venue.aboutFeatured);
const featuredVenuePhotos = getFeaturedPhotos();
const agendaPreview = schedule.sessions.slice(0, 4);
const cta = isLandingMode ? home.cta : home.ctaFull;
---

<BaseLayout title="Innovate" description={siteDescription} overlayHeader>
  <Hero />

  <Section class="about-section">
    <div class="about-grid">
      <div class="about-copy">
        <p class="eyebrow">{home.about.eyebrow}</p>
        <h2 class="about-title">{home.about.title}</h2>
        {home.about.lead && <p class="about-lead">{home.about.lead}</p>}
        <div class="about-body">
          <p>{home.about.body}</p>
        </div>
        {
          home.about.bodySecondary && home.about.highlights && (
            <div class="about-conference-will">
              <p class="about-conference-will-label">{home.about.bodySecondary}</p>
              <ul class="about-highlights">
                {home.about.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
        {
          !isLandingMode && (
            <div class="about-actions">
              <Button href="/register">Register</Button>
              <Button href="/speakers" variant="secondary">Meet the faculty</Button>
            </div>
          )
        }
      </div>
      {
        aboutImage && (
          <figure class="image-frame about-media">
            <img src={aboutImage.src} alt={aboutImage.alt} loading="lazy" decoding="async" />
          </figure>
        )
      }
    </div>
    {
      isLandingMode && registerUrl && (
        <div class="section-register">
          <Button href={registerUrl} size="lg" target="_blank" rel="noopener noreferrer">
            Register now
          </Button>
          <p class="register-price">{pricingNote}</p>
        </div>
      )
    }
  </Section>

  {
    isLandingMode ? (
      <Section
        class="coming-soon-section"
        variant="soft"
        eyebrow={home.comingSoon.eyebrow}
        title={home.comingSoon.title}
        intro={home.comingSoon.intro}
      >
        <div class="grid grid-3">
          {home.comingSoon.items.map((item) => (
            <article class="card coming-soon-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
        {
          registerUrl && (
            <div class="section-register">
              <Button href={registerUrl} size="lg" target="_blank" rel="noopener noreferrer">
                Register now
              </Button>
              <p class="register-price">{pricingNote}</p>
            </div>
          )
        }
      </Section>
    ) : (
      <>
        <Section
          variant="soft"
          eyebrow={home.experience.eyebrow}
          title={home.experience.title}
          intro={home.experience.intro}
        >
          <div class="grid grid-3">
            {home.experience.items.map((item) => <ExperienceCard {...item} />)}
          </div>
        </Section>

        <Section eyebrow={home.agenda.eyebrow} title={home.agenda.title} intro={home.agenda.intro}>
          <ol class="agenda-preview">
            {
              agendaPreview.map((session) => (
                <li class="agenda-preview-item card">
                  <p class="agenda-time">{session.time}</p>
                  <div>
                    <h3>{session.title}</h3>
                    <p>{session.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="agenda-actions">
            <Button href="/schedule">{home.agenda.cta}</Button>
            <Button href="/register" variant="secondary">Register</Button>
          </div>
        </Section>
      </>
    )
  }

  <Section
    variant="soft"
    eyebrow={home.venue.eyebrow}
    title={home.venue.title}
    intro={home.venue.intro}
    introWide
  >
    {
      isLandingMode ? (
        <>
          <VenueCollage photos={featuredVenuePhotos} showCaptions={false} equalSize />
          <div class="section-register">
            {
              registerUrl && (
                <Button href={registerUrl} size="lg" target="_blank" rel="noopener noreferrer">
                  Register now
                </Button>
              )
            }
            <Button href="/venue#getting-there" variant="secondary" size="lg">Getting there</Button>
            {registerUrl && <p class="register-price">{pricingNote}</p>}
          </div>
        </>
      ) : (
        <div class="split venue-split">
          <VenueCollage photos={featuredVenuePhotos} />
          <div class="content">
            <h2>On-site experience</h2>
            <ul>
              <li>Registration and light breakfast from 7:30 AM</li>
              <li>Single-room program 8:30 AM–4:00 PM with lunch and sponsor showcase</li>
              <li>Cocktail hour 4:00–5:00 PM</li>
            </ul>
            <div class="about-actions">
              <Button href="/venue">{home.venue.cta}</Button>
            </div>
          </div>
        </div>
      )
    }
  </Section>

  {
    isLandingMode ? (
      <NewsletterSignup eyebrow={cta.eyebrow} title={cta.title} body={cta.body} />
    ) : (
      <CtaBand
        eyebrow={cta.eyebrow}
        title={cta.title}
        body={cta.body}
        primaryHref="/register"
        primaryLabel={cta.primaryCta}
        secondaryHref="/contact"
        secondaryLabel={cta.secondaryCta}
      />
    )
  }
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    align-self: center;
  }

  .about-title {
    margin: 0;
    color: var(--color-navy);
    white-space: pre-line;
    font-size: clamp(2rem, 3.4vw, 2.85rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .about-lead {
    margin: 18px 0 0;
    max-width: 46ch;
    color: var(--color-muted);
    font-size: clamp(1.02rem, 1.8vw, 1.12rem);
    line-height: 1.55;
  }

  .about-body {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }

  .about-body p {
    margin: 0;
    max-width: 58ch;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .about-conference-will {
    margin-top: 24px;
  }

  .about-conference-will-label {
    margin: 0 0 12px;
    color: var(--color-navy);
    font-weight: 700;
  }

  .about-highlights {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .about-highlights li + li {
    margin-top: 10px;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .section-register {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .register-price {
    flex-basis: 100%;
    margin: 4px 0 0;
    color: var(--color-muted);
    font-size: 0.98rem;
    font-weight: 700;
    text-align: center;
  }

  .about-media {
    margin: 0;
    aspect-ratio: 3 / 2;
    width: 100%;
    justify-self: stretch;
  }

  .about-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .coming-soon-section :global(.section-heading) {
    max-width: 42rem;
  }

  .coming-soon-section :global(.section-heading p:not(.eyebrow)) {
    text-wrap: balance;
  }

  .coming-soon-card h3 {
    margin: 0 0 10px;
    color: var(--color-navy);
    font-size: 1.15rem;
  }

  .coming-soon-card p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .venue-split {
    align-items: center;
  }

  .agenda-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .agenda-preview {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agenda-preview-item {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .agenda-time {
    margin: 0;
    color: var(--color-brand);
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .agenda-preview-item h3 {
    margin: 0 0 8px;
    color: var(--color-navy);
    font-size: 1.15rem;
  }

  .agenda-preview-item p:last-child {
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .about-title {
      max-width: none;
    }

    .about-lead,
    .about-body p {
      max-width: none;
    }

    .about-media {
      justify-self: stretch;
      width: 100%;
      aspect-ratio: 3 / 2;
    }

    .agenda-preview-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
