---
import HeroBackground from "./HeroBackground.astro";
import StatGrid from "./StatGrid.astro";
import EventFactsBar from "./EventFactsBar.astro";
import { isLandingMode } from "../lib/launch";
import { eventConfig } from "../lib/event-config";
import home from "../data/home.json";

const { hero, stats } = home;
const heroDate = eventConfig.eventDateDisplay;
---

<section class="hero">
  <HeroBackground />
  <div class="container hero-inner">
    <div class="hero-content">
      <img
        class="hero-logo"
        src="/images/branding/Innovate_Logo_WhiteOnBlack.svg"
        alt="Innovate"
        width="216"
        height="58"
        loading="eager"
        decoding="async"
      />
      <p class="hero-date">{heroDate}</p>
      <h1 class="display-title">{hero.title}</h1>
      <p class="display-subtitle">{hero.subtitle}</p>
      {!isLandingMode && <StatGrid stats={stats} />}
    </div>
    <EventFactsBar registerHref={isLandingMode ? "/contact" : "/register"} registerLabel={isLandingMode ? "Contact us" : "Register"} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: var(--hero-min-height);
    padding: 120px 0 56px;
    color: var(--color-hero-text);
    background: var(--color-hero-bg);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 34px;
  }

  .hero-content {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
  }

  .hero-logo {
    width: min(100%, 280px);
    height: auto;
    margin-bottom: 8px;
  }

  .hero-date {
    margin: 0;
    padding: 14px 28px;
    border: 1px solid rgb(201 169 98 / 45%);
    border-radius: 999px;
    background: rgb(15 15 15 / 42%);
    color: var(--color-brand);
    font-size: clamp(1.2rem, 2.8vw, 1.65rem);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: 0 12px 32px rgb(0 0 0 / 22%);
  }

  .hero-content :global(.stat-grid) {
    width: min(100%, 720px);
    margin-top: 8px;
  }
</style>
