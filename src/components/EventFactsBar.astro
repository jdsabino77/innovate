---
import Button from "./Button.astro";
import { eventConfig, venueDisplay } from "../lib/event-config";

interface Props {
  registerHref?: string;
  registerLabel?: string;
  showRegisterAction?: boolean;
}

const {
  registerHref = "/register",
  registerLabel = "Register",
  showRegisterAction = true,
} = Astro.props;
---

<div class="facts-bar">
  <div>
    <dt>Date</dt>
    <dd>{eventConfig.eventDateDisplay}</dd>
  </div>
  <div>
    <dt>Venue</dt>
    <dd>{venueDisplay}</dd>
  </div>
  <div>
    <dt>Host</dt>
    <dd>{eventConfig.host}</dd>
  </div>
  {
    showRegisterAction && (
      <div class="facts-bar-action">
        <Button href={registerHref}>{registerLabel}</Button>
      </div>
    )
  }
</div>

<style>
  .facts-bar-action {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 820px) {
    .facts-bar-action {
      justify-content: stretch;
    }

    .facts-bar-action :global(.button) {
      width: 100%;
    }
  }
</style>
